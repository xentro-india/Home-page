# Deployment Configuration
# Set the confirmed production canonical URL (e.g. https://your-confirmed-domain.com)
NEXT_PUBLIC_SITE_URL=

# SMTP Email Configuration (for Career Applications)
# Configure these variables in your deployment environment or in .env.local for local testing.
# Never commit real passwords, print secrets to logs, or expose credentials in client-side code.
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hiring@xentro.in
SMTP_PASSWORD=
SMTP_FROM="Xentro Careers" <hiring@xentro.in>
